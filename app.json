{
  "expo": {
    "name": "SwimLab",
    "slug": "swimlab",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06B6D4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rdddevapp.swimlab"
    },
    "android": {
      "package": "com.rdddevapp.swimlab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#01236e"
        }
      ]
    ],
    "scheme": "swimlab"
  }
}
